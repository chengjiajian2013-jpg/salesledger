{
  "name": "salesledger",
  "version": "1.0.0",
  "description": "按笔记录交易的个人工作台",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create salesledger-db",
    "db:init": "wrangler d1 execute salesledger-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute salesledger-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
